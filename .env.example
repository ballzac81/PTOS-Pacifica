# PTOS — Pacifica Edition  |  Configuration
# Copy to .env and fill in the values.

## REQUIRED
# Solana private key (base58 string from Phantom/Solflare export)
SOLANA_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY

# Shared secret for TradingView webhooks + manual endpoints
SECRET_TOKEN=generate_a_long_random_hex_string

## NETWORK
PACIFICA_API_URL=https://api.pacifica.fi/api/v1
# Optional testnet:
# PACIFICA_API_URL=https://test-api.pacifica.fi/api/v1

## POSITION SIZING
# Preferred: fixed USDC notional per trade (position ≈ this × leverage)
POSITION_SIZE_USDC=25
# Alternative (approximate): fraction of equity
# POSITION_SIZE_PCT=0.10
LEVERAGE=3
SLIPPAGE_PERCENT=0.5

## SELL BEHAVIOUR
# short       = close any open long then open short (or just open short)
# close_long  = exit the long and stay flat
# open_short  = open short without touching existing long
SELL_MODE=short
SELL_PCT=1.0

## SIGNAL WINDOW
# Seconds a buy/sell signal stays armed. 0 = never expires
WINDOW_SECONDS=0

## TELEGRAM (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

## TRAILING STOP
TRAILING_STOP_PCT=0.05
# Per-coin overrides (examples)
# SOL_TRAILING_STOP_PCT=0.04
# BTC_TRAILING_STOP_PCT=0.03
MONITOR_INTERVAL_SECONDS=30

## STOP LOSS FROM ENTRY
# Close if price moves against you by this % from entry. 0 = disabled
STOP_LOSS_PCT=0

## MAX HOLD TIME
# Auto-close after N seconds. 0 = disabled
MAX_HOLD_SECONDS=0

## RE-ARM AFTER STOP-OUT
REARM_AFTER_STOP=false
REARM_DELAY_SECONDS=3600

## COOLDOWN
# Seconds to wait after a close before allowing a new entry on that coin
COOLDOWN_SECONDS=0

## HTF BIAS FILTER
HTF_FILTER_ENABLED=false
